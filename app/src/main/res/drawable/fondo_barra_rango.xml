    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background" />
            <stroke android:width="1.5dp" android:color="@color/uninorte_red" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
